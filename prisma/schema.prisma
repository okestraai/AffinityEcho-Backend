generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//
// USER PROFILES
//
model user_profiles {
  id                       String   @id @default(uuid()) @db.Uuid
  username                 String   @unique @db.VarChar(50)
  email                    String?  @db.VarChar(254)
  avatar                   String   @default("User")
  first_name_encrypted     String?   @default("") @db.VarChar(50)
  last_name_encrypted      String?   @default("") @db.VarChar(50)



  // SHARED/BASIC PROFILE FIELDS (used by both mentor and mentee)
  bio                      String?
  job_title                String?
  location                 String?
  years_experience         Int?
  skills                   String[] @default([])
  linkedin_url             String?


  // Encrypted PII
  race_encrypted           String?
  gender_encrypted         String?
  career_level_encrypted   String?   @db.Text
  company_encrypted        String?   @db.Text
  affinity_tags_encrypted  String?   @db.Text


  // Onboarding & Demographics
  has_completed_onboarding Boolean  @default(false)
  is_willing_to_mentor     Boolean  @default(false)
  badges                   String[] @default([])



 // MENTOR-SPECIFIC FIELDS (only used when user is a mentor)
  mentor_bio               String?   @db.Text
  mentor_expertise         String[]  @default([])
  mentor_industries        String[]  @default([])
  mentor_availability      String?
  mentor_response_time     String?
  mentor_style             String?
  mentor_languages         String[]  @default([])
  mentor_hourly_rate       Int?
  is_active_mentor         Boolean   @default(false)
  mentor_profile_created_at DateTime? @db.Timestamptz(3)
    
    // MENTEE-SPECIFIC FIELDS (only used when user is a mentee)
  mentee_bio               String?   @db.Text
  mentee_goals             String?   @db.Text
  mentee_interests         String[]  @default([])
  mentee_industries        String[]  @default([])
  mentee_availability      String?
  mentee_urgency           String?   @db.VarChar(20)
  mentee_topic             String?   @db.Text
  is_active_mentee         Boolean   @default(false)
  mentored_style           String?
  mentee_languages         String[]  @default([])
  mentee_profile_created_at DateTime? @db.Timestamptz(3)


  // Company Type (static or other)
  company_type             String?   @default("static") @db.VarChar(20)
  communication_method String?   @db.VarChar(50)
  mentoring_as             String?   @db.VarChar(20) // 'mentor', 'mentee', 'both', null


  // Privacy
  privacy_level            String   @default("anonymous") @db.VarChar(20)

  // Stats
  reputation_score         Int      @default(0)
  total_posts              Int      @default(0)
  total_comments           Int      @default(0)
  helpful_votes_received   Int      @default(0)
  mentorship_sessions_completed Int @default(0)
  successful_referrals     Int      @default(0)

  // Timestamps
  created_at               DateTime @default(now()) @db.Timestamptz(3)
  updated_at               DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  last_active_at           DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  referral_posts            referral_posts[]
  sent_connections          referral_connections[] @relation("sent_connections")
  received_connections      referral_connections[] @relation("received_connections")
  forum_topics              forum_topics[]
  forum_comments            forum_comments[]
  topic_reactions           topic_reactions[]
  comment_reactions         comment_reactions[]
  mentor_relationships      mentorship_relationships[] @relation("mentor_relationships")
  mentee_relationships      mentorship_relationships[] @relation("mentee_relationships")
  mentorship_requests       mentorship_requests[] @relation("mentorship_requests")
  mentorship_bookmarks      mentorship_bookmarks[] @relation("mentorship_bookmarks_user")
  bookmarked_by             mentorship_bookmarks[] @relation("mentorship_bookmarks_target")
  conversations_user1       conversations[] @relation("conversations_user1")
  conversations_user2       conversations[] @relation("conversations_user2")
  messages                  messages[]
  notification_users        notifications[] @relation("notification_user")
  notification_actors       notifications[] @relation("notification_actor")
  followers                 user_follows[] @relation("user_followers")
  following                 user_follows[] @relation("user_following")
  identity_reveals_requester identity_reveals[] @relation("identity_reveals_requester")
  identity_reveals_responder identity_reveals[] @relation("identity_reveals_responder")
  forum_memberships         forum_members[] @relation("forum_memberships")
  nooks_created             nooks[] @relation("nook_creator")
  nook_memberships          nook_members[] @relation("nook_memberships")
  nook_messages             nook_messages[] @relation("nook_messages")
  nook_reactions            nook_reactions[] @relation("nook_reactions")
  nook_message_reactions    nook_message_reactions[] @relation("nook_message_reactions")
   direct_requests_sent      mentorship_direct_requests[] @relation("direct_request_requester")
  direct_requests_received  mentorship_direct_requests[] @relation("direct_request_target")
    referral_likes        referral_likes[]
  referral_bookmarks    referral_bookmarks[]
  referral_comments     referral_comments[]

  @@map("user_profiles")
}

//
// FORUMS
//
model forums {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String
  icon            String
  is_global       Boolean  @default(false)
  company_name    String?
  category        String   @db.VarChar(20)
  topic_count     Int      @default(0)
  member_count    Int      @default(0)
  last_activity   DateTime @default(now()) @db.Timestamptz(3)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  rules           String[]
  moderators      String[]

  // Relations
  forum_topics    forum_topics[]
  forum_members   forum_members[]

  @@map("forums")
}

model forum_members {
  id        String   @id @default(uuid()) @db.Uuid
  forum_id  String   @db.Uuid
  user_id   String   @db.Uuid
  joined_at DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  forum     forums        @relation(fields: [forum_id], references: [id], onDelete: Cascade)
  user      user_profiles @relation(fields: [user_id], references: [id], onDelete: Cascade, name: "forum_memberships")

  @@unique([forum_id, user_id])
  @@map("forum_members")
}

//
// FORUM TOPICS & COMMENTS
//
model forum_topics {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  forum_id           String   @db.Uuid
  title              String
  content            String
  content_encrypted  String?
  company_name       String?
  scope              String   @default("global")
  is_anonymous       Boolean  @default(true)
  is_pinned          Boolean  @default(false)
  is_locked          Boolean  @default(false)
  tags               String[] @default([])
  affinity_groups    String[] @default([])
  link               String?

  views_count        Int      @default(0)
  comments_count     Int      @default(0)
  reaction_seen_count      Int @default(0)
  reaction_validated_count Int @default(0)
  reaction_inspired_count  Int @default(0)
  reaction_heard_count     Int @default(0)

  created_at         DateTime @default(now()) @db.Timestamptz(3)
  updated_at         DateTime @updatedAt @db.Timestamptz(3)
  last_activity_at   DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  user_profile user_profiles    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  forum        forums           @relation(fields: [forum_id], references: [id], onDelete: Cascade)
  comments     forum_comments[]
  reactions    topic_reactions[]

  @@map("forum_topics")
}

model forum_comments {
  id                 String   @id @default(uuid()) @db.Uuid
  topic_id           String   @db.Uuid
  user_id            String   @db.Uuid
  parent_comment_id  String?  @db.Uuid
  content            String
  content_encrypted  String?
  is_anonymous       Boolean  @default(true)
  is_removed         Boolean  @default(false)
  removed_reason     String?

  helpful_count      Int      @default(0)
  supportive_count   Int      @default(0)

  created_at         DateTime @default(now()) @db.Timestamptz(3)
  updated_at         DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  topic        forum_topics     @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  user_profile user_profiles    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent       forum_comments?  @relation("comment_replies", fields: [parent_comment_id], references: [id], onDelete: Cascade)
  replies      forum_comments[] @relation("comment_replies")
  reactions    comment_reactions[]

  @@map("forum_comments")
}

//
// REACTIONS
//
model topic_reactions {
  id           String @id @default(uuid()) @db.Uuid
  topic_id     String @db.Uuid
  user_id      String @db.Uuid
  reaction_type String

  created_at   DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  topic        forum_topics  @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  user_profile user_profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([topic_id, user_id, reaction_type])
  @@map("topic_reactions")
}

model comment_reactions {
  id            String   @id @default(uuid()) @db.Uuid
  comment_id    String   @db.Uuid
  user_id       String   @db.Uuid
  reaction_type String
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  comment forum_comments @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user    user_profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([comment_id, user_id, reaction_type])
  @@map("comment_reactions")
}

//
// REFERRAL POSTS
//
model referral_posts {
  id                     String   @id @default(uuid()) @db.Uuid
  user_id                String   @db.Uuid
  type                   String   // request | offer
  title_encrypted        String
  company_encrypted      String
  job_title_encrypted    String?
  job_link               String?
  description_encrypted  String

  scope                  String   @default("global")
  status                 String   @default("open")
  affinity_groups        String[] @default([])
  available_slots        Int?
  total_slots            Int?
  tags                   String[] @default([])
  required_skills        String[] @default([])
  preferred_experience   String?

  views_count            Int      @default(0)
  likes_count            Int      @default(0)
  comments_count         Int      @default(0)
  bookmarks_count        Int      @default(0)
  connection_requests_count Int   @default(0)

  created_at             DateTime @default(now()) @db.Timestamptz(3)
  updated_at             DateTime @updatedAt @db.Timestamptz(3)
  last_activity_at       DateTime @default(now()) @db.Timestamptz(3)
  expires_at             DateTime? @db.Timestamptz(3)

  // Relations
  user_profile user_profiles    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  connections  referral_connections[]
    likes      referral_likes[]
  bookmarks  referral_bookmarks[]
  comments   referral_comments[]

  @@map("referral_posts")
}

//
// REFERRAL CONNECTIONS
//
model referral_connections {
  id                     String   @id @default(uuid()) @db.Uuid
  referral_post_id       String   @db.Uuid
  sender_id              String   @db.Uuid
  receiver_id            String   @db.Uuid
  status                 String   @default("pending")
  message_encrypted      String?
  sender_notes_encrypted String?
  receiver_notes_encrypted String?

  referral_submitted     Boolean  @default(false)
  interview_scheduled    Boolean  @default(false)
  offer_received         Boolean  @default(false)
  outcome_notes          String?
  identity_revealed      Boolean  @default(false)

  created_at             DateTime @default(now()) @db.Timestamptz(3)
  updated_at             DateTime @updatedAt @db.Timestamptz(3)
  responded_at           DateTime? @db.Timestamptz(3)

  // Relations
  referral_post referral_posts @relation(fields: [referral_post_id], references: [id], onDelete: Cascade)
  sender        user_profiles  @relation("sent_connections", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver      user_profiles  @relation("received_connections", fields: [receiver_id], references: [id], onDelete: Cascade)
  identity_reveals identity_reveals[]

  @@unique([referral_post_id, sender_id, receiver_id])
  @@map("referral_connections")
}

//
// IDENTITY REVEALS
//
model identity_reveals {
  id              String   @id @default(uuid()) @db.Uuid
  connection_id   String   @db.Uuid
  requester_id    String   @db.Uuid
  responder_id    String   @db.Uuid
  status          String   @default("pending")
  requester_message_encrypted String?

  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)
  responded_at    DateTime? @db.Timestamptz(3)

  // Relations
  connection referral_connections @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  requester  user_profiles        @relation("identity_reveals_requester", fields: [requester_id], references: [id], onDelete: Cascade)
  responder  user_profiles        @relation("identity_reveals_responder", fields: [responder_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, requester_id, responder_id])
  @@map("identity_reveals")
}


model referral_likes {
  id                String   @id @default(uuid()) @db.Uuid
  referral_post_id  String   @db.Uuid
  user_id           String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  
  referral_post     referral_posts @relation(fields: [referral_post_id], references: [id], onDelete: Cascade)
  user              user_profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([referral_post_id, user_id])
  @@index([user_id])
  @@index([referral_post_id])
  @@map("referral_likes")
}

model referral_bookmarks {
  id                String   @id @default(uuid()) @db.Uuid
  referral_post_id  String   @db.Uuid
  user_id           String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  
  referral_post     referral_posts @relation(fields: [referral_post_id], references: [id], onDelete: Cascade)
  user              user_profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([referral_post_id, user_id])
  @@index([user_id])
  @@index([referral_post_id])
  @@map("referral_bookmarks")
}

model referral_comments {
  id                String   @id @default(uuid()) @db.Uuid
  referral_post_id  String   @db.Uuid
  user_id           String   @db.Uuid
  content           String   @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @updatedAt @db.Timestamptz(3)
  
  referral_post     referral_posts @relation(fields: [referral_post_id], references: [id], onDelete: Cascade)
  user              user_profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([referral_post_id])
  @@index([user_id])
  @@map("referral_comments")
}
//
// MENTORSHIP
//
model mentorship_relationships {
  id                  String   @id @default(uuid()) @db.Uuid
  mentor_id           String   @db.Uuid
  mentee_id           String   @db.Uuid
  
  // Request details
  request_topic       String?
  request_goals_encrypted String?  @db.Text
  request_background_encrypted String? @db.Text
  request_availability String?
  request_communication_method String? @db.VarChar(50)
  request_urgency     String?   @db.VarChar(20)
  
  status              String   @default("pending") @db.VarChar(50)
  // pending, accepted, active, completed, declined, cancelled
  
  mentor_skills       String[] @default([])
  mentee_goals_encrypted String?
  meeting_frequency   String?
  total_sessions      Int      @default(0)
  completed_sessions  Int      @default(0)
  next_session_at     DateTime? @db.Timestamptz(3)

  // Match score
  match_score         Int?
  
  // Ratings & Feedback
  mentor_rating       Int?
  mentee_rating       Int?
  mentor_feedback_encrypted String? @db.Text
  mentee_feedback_encrypted String? @db.Text

  // Timestamps
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)
  started_at          DateTime? @db.Timestamptz(3)
  completed_at        DateTime? @db.Timestamptz(3)
  declined_at         DateTime? @db.Timestamptz(3)
  cancelled_at        DateTime? @db.Timestamptz(3)
  last_contact_at     DateTime? @db.Timestamptz(3)

  // Relations
  mentor user_profiles @relation("mentor_relationships", fields: [mentor_id], references: [id], onDelete: Cascade)
  mentee user_profiles @relation("mentee_relationships", fields: [mentee_id], references: [id], onDelete: Cascade)
  sessions mentorship_sessions[]

  @@unique([mentor_id, mentee_id])
  @@index([status])
  @@index([mentor_id, status])
  @@index([mentee_id, status])
  @@map("mentorship_relationships")
}

model mentorship_sessions {
  id                  String   @id @default(uuid()) @db.Uuid
  relationship_id     String   @db.Uuid
  scheduled_at        DateTime @db.Timestamptz(3)
  duration_minutes    Int
  meeting_url         String?
  agenda_encrypted    String?
  status              String   @default("scheduled")
  mentor_notes_encrypted     String?
  mentee_notes_encrypted     String?
  session_notes_encrypted    String?

  mentor_feedback     String?
  mentee_feedback     String?
  mentor_rating       Int?
  mentee_rating       Int?

  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  relationship mentorship_relationships @relation(fields: [relationship_id], references: [id], onDelete: Cascade)

  @@map("mentorship_sessions")
}

model mentorship_requests {
  id                  String   @id @default(uuid()) @db.Uuid
  requester_id        String   @db.Uuid
  target_user_id      String?  @db.Uuid // null for general requests
  
  topic               String
  goals_encrypted     String   @db.Text
  background_encrypted String? @db.Text
  availability        String
  communication_method String  @db.VarChar(50)
  urgency             String   @db.VarChar(20)
  
  request_type        String   @db.VarChar(20) // 'seeking_mentor', 'offering_mentorship'
  status              String   @default("open") @db.VarChar(50)
  // open, matched, withdrawn, expired
  
  matched_with_id     String?  @db.Uuid
  matched_at          DateTime? @db.Timestamptz(3)
  
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)
  expires_at          DateTime? @db.Timestamptz(3)
  
  // Relations
  requester user_profiles @relation("mentorship_requests", fields: [requester_id], references: [id], onDelete: Cascade)
  
  @@index([requester_id])
  @@index([status])
  @@index([request_type])
  @@index([created_at])
  @@map("mentorship_requests")
}


//
// MENTORSHIP DIRECT REQUESTS (NEW TABLE)
//
model mentorship_direct_requests {
  id                  String   @id @default(uuid()) @db.Uuid
  requester_id        String   @db.Uuid
  target_user_id      String   @db.Uuid
  request_type        String   @db.VarChar(20) // 'mentor_request', 'mentee_request'
  message             String   @db.Text
  
  // Optional fields for direct requests
  topic               String?  @db.VarChar(200)
  goals               String?  @db.Text
  job_title           String?
  company             String?
  years_of_experience String?
  location            String?
  career_level        String?
  bio                 String?  @db.Text
  is_read_by_requester         Boolean  @default(false)
  is_read_by_target         Boolean  @default(false)
  
  status              String   @default("pending") @db.VarChar(20)
  // pending, accepted, declined, cancelled
  
  response_message    String?  @db.Text
  responded_at        DateTime? @db.Timestamptz(3)
  
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)
  
  // Relations with explicit names
  requester user_profiles @relation("direct_request_requester", fields: [requester_id], references: [id], onDelete: Cascade)
  target_user user_profiles @relation("direct_request_target", fields: [target_user_id], references: [id], onDelete: Cascade)
  
  @@unique([requester_id, target_user_id], name: "unique_pending_direct_request")
  @@index([target_user_id, status])
  @@index([requester_id])
  @@index([status])
  @@map("mentorship_direct_requests")
}
model mentorship_bookmarks {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @db.Uuid
  bookmarked_user_id  String   @db.Uuid
  notes               String?  @db.Text
  
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  
  // Relations
  user           user_profiles @relation("mentorship_bookmarks_user", fields: [user_id], references: [id], onDelete: Cascade)
  bookmarked_user user_profiles @relation("mentorship_bookmarks_target", fields: [bookmarked_user_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, bookmarked_user_id])
  @@index([user_id])
  @@map("mentorship_bookmarks")
}

//
// MESSAGING & NOTIFICATIONS
//
model conversations {
  id                  String   @id @default(uuid()) @db.Uuid
  user1_id            String   @db.Uuid
  user2_id            String   @db.Uuid
  context_type        String?
  context_id          String?  @db.Uuid
  is_active           Boolean  @default(true)
  user1_cleared_at    DateTime? @db.Timestamptz(3)
  user2_cleared_at    DateTime? @db.Timestamptz(3)
  user1_identity_revealed Boolean @default(false)
  user2_identity_revealed Boolean @default(false)

  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)
  last_message_at     DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  user1    user_profiles @relation("conversations_user1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2    user_profiles @relation("conversations_user2", fields: [user2_id], references: [id], onDelete: Cascade)
  messages messages[]

  @@unique([user1_id, user2_id, context_type, context_id])
  @@map("conversations")
}

model messages {
  id                  String   @id @default(uuid()) @db.Uuid
  conversation_id     String   @db.Uuid
  sender_id           String   @db.Uuid
  content_encrypted   String
  content_type        String   @default("text")
  file_url            String?
  file_name           String?
  file_size           Int?
  file_type           String?

  is_delivered        Boolean  @default(false)
  is_read             Boolean  @default(false)
  read_at             DateTime? @db.Timestamptz(3)
  is_flagged          Boolean  @default(false)
  flagged_reason      String?

  created_at          DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       user_profiles @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

model notifications {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @db.Uuid
  actor_id            String?  @db.Uuid
  type                String
  title               String
  message             String
  action_url          String?
  reference_id        String?  @db.Uuid
  reference_type      String?
  metadata            Json     @default("{}")
  is_read             Boolean  @default(false)
  is_delivered        Boolean  @default(false)
  action_taken        Boolean  @default(false)
  delivery_method     String[] @default(["in_app"])

  created_at          DateTime @default(now()) @db.Timestamptz(3)
  read_at             DateTime? @db.Timestamptz(3)
  delivered_at        DateTime? @db.Timestamptz(3)

  // Relations
  user_profile user_profiles @relation("notification_user", fields: [user_id], references: [id], onDelete: Cascade)
  actor        user_profiles? @relation("notification_actor", fields: [actor_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model user_follows {
  id                  String   @id @default(uuid()) @db.Uuid
  follower_id         String   @db.Uuid
  following_id        String   @db.Uuid
  created_at          DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  follower  user_profiles @relation("user_followers", fields: [follower_id], references: [id], onDelete: Cascade)
  following user_profiles @relation("user_following", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@map("user_follows")
}

//
// NOOKS (Anonymous 24-hour safe spaces)
//
model nooks {
  id                  String   @id @default(uuid()) @db.Uuid
  creator_id          String   @db.Uuid
  title               String   @db.VarChar(200)
  description         String
  urgency             String   @default("medium") @db.VarChar(20) // low, medium, high
  scope               String   @default("company") @db.VarChar(20) // company, global
  temperature         String   @default("cool") @db.VarChar(20) // hot, warm, cool
  hashtags            String[] @default([])
  
  // Stats
  members_count       Int      @default(0)
  messages_count      Int      @default(0)
  views_count         Int      @default(0)
  
  // Status
  is_active           Boolean  @default(true)
  is_locked           Boolean  @default(false)
  locked_reason       String?
  
  // Timestamps
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)
  last_activity_at    DateTime @default(now()) @db.Timestamptz(3)
  expires_at          DateTime @db.Timestamptz(3) // Auto-delete after 24 hours
  
  // Relations
  creator             user_profiles      @relation("nook_creator", fields: [creator_id], references: [id], onDelete: Cascade)
  messages            nook_messages[]
  members             nook_members[]
  reactions           nook_reactions[]

  @@index([expires_at])
  @@index([scope])
  @@index([is_active])
  @@index([created_at])
  @@map("nooks")
}

model nook_members {
  id                  String   @id @default(uuid()) @db.Uuid
  nook_id             String   @db.Uuid
  user_id             String   @db.Uuid
  
  // Member settings
  is_anonymous        Boolean  @default(true)
  notifications_enabled Boolean @default(true)
  
  // Stats
  messages_sent       Int      @default(0)
  
  joined_at           DateTime @default(now()) @db.Timestamptz(3)
  last_read_at        DateTime @default(now()) @db.Timestamptz(3)
  
  // Relations
  nook                nooks         @relation(fields: [nook_id], references: [id], onDelete: Cascade)
  user                user_profiles @relation("nook_memberships", fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([nook_id, user_id])
  @@index([user_id])
  @@map("nook_members")
}

model nook_messages {
  id                  String   @id @default(uuid()) @db.Uuid
  nook_id             String   @db.Uuid
  user_id             String   @db.Uuid
  parent_message_id   String?  @db.Uuid
  
  content             String
  is_anonymous        Boolean  @default(true)
  
  // Moderation
  is_removed          Boolean  @default(false)
  removed_reason      String?
  is_flagged          Boolean  @default(false)
  flagged_count       Int      @default(0)
  
  // Reaction counts
  heard_count         Int      @default(0)
  validated_count     Int      @default(0)
  helpful_count       Int      @default(0)
  
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)
  
  // Relations
  nook                nooks              @relation(fields: [nook_id], references: [id], onDelete: Cascade)
  user                user_profiles      @relation("nook_messages", fields: [user_id], references: [id], onDelete: Cascade)
  parent              nook_messages?     @relation("message_replies", fields: [parent_message_id], references: [id], onDelete: Cascade)
  replies             nook_messages[]    @relation("message_replies")
  reactions           nook_message_reactions[]
  
  @@index([nook_id])
  @@index([user_id])
  @@index([created_at])
  @@map("nook_messages")
}

model nook_reactions {
  id                  String   @id @default(uuid()) @db.Uuid
  nook_id             String   @db.Uuid
  user_id             String   @db.Uuid
  reaction_type       String   @db.VarChar(20) // heard, validated, inspired, etc.
  
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  
  // Relations
  nook                nooks         @relation(fields: [nook_id], references: [id], onDelete: Cascade)
  user                user_profiles @relation("nook_reactions", fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([nook_id, user_id, reaction_type])
  @@index([nook_id])
  @@map("nook_reactions")
}

model nook_message_reactions {
  id                  String   @id @default(uuid()) @db.Uuid
  message_id          String   @db.Uuid
  user_id             String   @db.Uuid
  reaction_type       String   @db.VarChar(20) // heard, validated, helpful, supportive
  
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  
  // Relations
  message             nook_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user                user_profiles @relation("nook_message_reactions", fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([message_id, user_id, reaction_type])
  @@index([message_id])
  @@map("nook_message_reactions")
}



