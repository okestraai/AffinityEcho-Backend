# =============================================================================
# AffinityEcho API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (Azure PostgreSQL)
# Option A: Individual params (recommended — avoids password URL-encoding issues)
PG_HOST=affinityecho.postgres.database.azure.com
PG_PORT=5432
PG_DATABASE=affinityecho
PG_USER=affinityecho
PG_PASSWORD=
PG_SSL=true
# Option B: Connection string (alternative)
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# JWT Secrets (generate unique random values, 64+ characters each)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=
JWT_RESET_SECRET=

# Encryption Key (32-byte base64 encoded)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# SMTP (Email)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set to 'true' for TLS in production (e.g., AWS ElastiCache, Redis Cloud)
REDIS_TLS=false

# Firebase Push Notifications (FCM)
# Paste the full service account JSON as a single-line string (from Firebase Console → Project Settings → Service Accounts)
FIREBASE_SERVICE_ACCOUNT=''

# Expo Push Notifications (kept during token migration period)
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# vLLM (Okestra AI Insights — direct call, bypasses Supabase Edge Function)
VLLM_CHAT_URL=https://chat.affinityecho.com
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Token Expiration (optional, in minutes)
EMAIL_VERIFICATION_TOKEN_EXPIRATION_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30

# Together.ai (Editorial AI Moderation)
# Get your key from https://api.together.xyz → Account Settings → API Keys
# Key starts with tgp_ — one key per environment, rotate every 90 days
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
TOGETHER_TIMEOUT_MS=15000
TOGETHER_MAX_RETRIES=3

# Moderation Control
# MODERATION_ENABLED: set to 'true' to activate AI moderation
# MODERATION_MODE: shadow (audit only) | allow_only | hide_enabled | full
MODERATION_ENABLED=false
MODERATION_MODE=shadow
MODERATION_CONCURRENCY=4
MODERATION_AUTO_REMOVE_CONFIDENCE=0.90
MODERATION_AUTO_HIDE_CONFIDENCE=0.75

# Moderation Sweep (safety net cron)
MODERATION_SWEEP_ENABLED=true
MODERATION_SWEEP_LOOKBACK_MINUTES=120
MODERATION_SWEEP_MAX_PER_RUN=100
