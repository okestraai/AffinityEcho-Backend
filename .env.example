# =============================================================================
# AffinityEcho API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (Azure PostgreSQL)
# Option A: Individual params (recommended — avoids password URL-encoding issues)
PG_HOST=affinityecho.postgres.database.azure.com
PG_PORT=5432
PG_DATABASE=affinityecho
PG_USER=affinityecho
PG_PASSWORD=
PG_SSL=true
# Option B: Connection string (alternative)
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT Secrets (generate unique random values, 64+ characters each)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=
JWT_RESET_SECRET=

# Encryption Key (32-byte base64 encoded)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# SMTP (Email)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set to 'true' for TLS in production (e.g., AWS ElastiCache, Redis Cloud)
REDIS_TLS=false

# Firebase Push Notifications (FCM)
# Paste the full service account JSON as a single-line string (from Firebase Console → Project Settings → Service Accounts)
FIREBASE_SERVICE_ACCOUNT=''

# Expo Push Notifications (kept during token migration period)
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# vLLM (Okestra AI Insights — direct call, bypasses Supabase Edge Function)
VLLM_CHAT_URL=https://chat.affinityecho.com
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Token Expiration (optional, in minutes)
EMAIL_VERIFICATION_TOKEN_EXPIRATION_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
