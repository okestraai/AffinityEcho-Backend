<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Identity Revealed - AffinityEcho</title>
    <!--[if gte mso 9]>
    <xml>
        <o:OfficeDocumentSettings>
            <o:AllowPNG/>
            <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
    </xml>
    <![endif]-->
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #4b5563; margin: 0; padding: 0; background-color: #f3f4f6;" bgcolor="#f3f4f6">
    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f3f4f6;" bgcolor="#f3f4f6">
    <tr><td align="center" style="padding: 20px 0;">
    <table cellpadding="0" cellspacing="0" border="0" width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.07);" bgcolor="#ffffff">
        <!-- Header -->
        <tr><td>
            <!--[if mso]>
            <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="width:600px;">
            <v:fill type="gradient" color="#9333ea" color2="#3b82f6" angle="135"/>
            <v:textbox style="mso-fit-shape-to-text:true" inset="0,0,0,0">
            <![endif]-->
            <div style="background: linear-gradient(135deg, #9333ea 0%, #4f46e5 50%, #3b82f6 100%); background-color: #9333ea; padding: 40px; text-align: center; color: white;">
                <h1 style="margin: 0; font-size: 28px; font-weight: 700; color: white;">Identity Revealed!</h1>
                <p style="margin: 10px 0 0; opacity: 0.9; font-size: 16px; color: white;">Your connection accepted the identity reveal</p>
            </div>
            <!--[if mso]></v:textbox></v:rect><![endif]-->
        </td></tr>

        <!-- Body -->
        <tr><td style="padding: 40px;">
            <p style="color: #4b5563;">Hello <strong style="color: #9333ea;"><%= username %></strong>,</p>
            <p style="font-size: 16px; color: #4b5563;">Your identity reveal request has been accepted! You and your connection can now see each other's real profiles.</p>

            <!-- Info Box -->
            <table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 25px 0;">
            <tr><td style="background-color: #faf5ff; border: 1px solid #e9d5ff; padding: 20px; border-radius: 8px;" bgcolor="#faf5ff">
                <p style="margin: 0 0 10px; color: #9333ea; font-weight: 600;">What's changed?</p>
                <ul style="margin: 0; color: #4b5563; padding-left: 20px;">
                    <li>You can now see each other's real names and profiles</li>
                    <li>Your conversations will show real identities going forward</li>
                    <li>Continue building your professional relationship</li>
                </ul>
            </td></tr>
            </table>

            <!-- Button -->
            <table cellpadding="0" cellspacing="0" border="0" style="margin: 30px auto;">
            <tr><td align="center" bgcolor="#9333ea" style="background-color: #9333ea; border-radius: 8px; padding: 14px 36px;">
                <a href="<%= viewUrl %>" style="color: white; text-decoration: none; font-weight: 600; font-size: 16px; display: inline-block;">View Connection</a>
            </td></tr>
            </table>
        </td></tr>

        <!-- Footer -->
        <tr><td style="background-color: #f9fafb; padding: 20px; text-align: center; border-top: 1px solid #e5e7eb;" bgcolor="#f9fafb">
            <p style="margin: 0 0 8px; color: #9ca3af; font-size: 14px;">You're receiving this because an identity reveal was accepted.</p>
            <p style="margin: 0; font-size: 12px; color: #9ca3af;">Need help? Contact us at <a href="mailto:<%= supportEmail %>" style="color: #4f46e5;"><%= supportEmail %></a></p>
            <p style="margin: 12px 0 0; font-size: 12px; color: #9ca3af;">&copy; 2025 AffinityEcho. Building stronger professionals together.</p>
        </td></tr>
    </table>
    </td></tr>
    </table>
</body>
</html>
