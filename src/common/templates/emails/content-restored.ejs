<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Content Restored - AffinityEcho</title>
    <!--[if gte mso 9]>
    <xml>
        <o:OfficeDocumentSettings>
            <o:AllowPNG/>
            <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
    </xml>
    <![endif]-->
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #4b5563; margin: 0; padding: 0; background-color: #f3f4f6;" bgcolor="#f3f4f6">
    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f3f4f6;" bgcolor="#f3f4f6">
    <tr><td align="center" style="padding: 20px 0;">
    <table cellpadding="0" cellspacing="0" border="0" width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.07);" bgcolor="#ffffff">
        <!-- Header -->
        <tr><td>
            <!--[if mso]>
            <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="width:600px;">
            <v:fill type="gradient" color="#059669" color2="#3b82f6" angle="135"/>
            <v:textbox style="mso-fit-shape-to-text:true" inset="0,0,0,0">
            <![endif]-->
            <div style="background: linear-gradient(135deg, #059669 0%, #0d9488 50%, #3b82f6 100%); background-color: #059669; padding: 40px; text-align: center; color: white;">
                <h1 style="margin: 0; font-size: 28px; font-weight: 700; color: white;">Your Content Has Been Restored</h1>
                <p style="margin: 10px 0 0; opacity: 0.9; font-size: 16px; color: white;">Good news — your <%= contentType %> is back</p>
            </div>
            <!--[if mso]></v:textbox></v:rect><![endif]-->
        </td></tr>

        <!-- Body -->
        <tr><td style="padding: 40px;">
            <p style="color: #4b5563;">Hello <strong style="color: #059669;"><%= username %></strong>,</p>
            <p style="font-size: 16px; color: #4b5563;">A human moderator has reviewed your <%= contentType %> that was previously hidden by our automated safety system. After review, your content has been restored and is now visible to the community again.</p>

            <!-- Success Box -->
            <table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 25px 0;">
            <tr><td style="background-color: #ecfdf5; border: 1px solid #a7f3d0; padding: 20px; border-radius: 8px; border-left: 4px solid #059669;" bgcolor="#ecfdf5">
                <p style="margin: 0; color: #065f46; font-weight: 600;">Human Review Complete</p>
                <p style="margin: 8px 0 0; color: #047857;">A moderator reviewed the AI's decision and determined your content does not violate our community guidelines. We apologize for any inconvenience.</p>
            </td></tr>
            </table>

            <p style="font-size: 16px; color: #4b5563;">We appreciate your patience while we continue to improve our moderation system. Your voice matters — keep sharing your experiences with the AffinityEcho community.</p>

            <!-- Button -->
            <table cellpadding="0" cellspacing="0" border="0" style="margin: 30px auto;">
            <tr><td align="center" bgcolor="#059669" style="background-color: #059669; border-radius: 8px; padding: 14px 36px;">
                <a href="<%= dashboardUrl %>" style="color: white; text-decoration: none; font-weight: 600; font-size: 16px; display: inline-block;">Go to Dashboard</a>
            </td></tr>
            </table>
        </td></tr>

        <!-- Footer -->
        <tr><td style="background-color: #f9fafb; padding: 20px; text-align: center; border-top: 1px solid #e5e7eb;" bgcolor="#f9fafb">
            <p style="margin: 0 0 8px; color: #9ca3af; font-size: 14px;">This is an automated moderation notification.</p>
            <p style="margin: 0; font-size: 12px; color: #9ca3af;">Need help? Contact us at <a href="mailto:<%= supportEmail %>" style="color: #4f46e5;"><%= supportEmail %></a></p>
            <p style="margin: 12px 0 0; font-size: 12px; color: #9ca3af;">&copy; 2025 AffinityEcho. Building stronger professionals together.</p>
        </td></tr>
    </table>
    </td></tr>
    </table>
</body>
</html>
