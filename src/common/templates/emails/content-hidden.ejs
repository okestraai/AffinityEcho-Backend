<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Content Hidden - AffinityEcho</title>
    <!--[if gte mso 9]>
    <xml>
        <o:OfficeDocumentSettings>
            <o:AllowPNG/>
            <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
    </xml>
    <![endif]-->
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #4b5563; margin: 0; padding: 0; background-color: #f3f4f6;" bgcolor="#f3f4f6">
    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f3f4f6;" bgcolor="#f3f4f6">
    <tr><td align="center" style="padding: 20px 0;">
    <table cellpadding="0" cellspacing="0" border="0" width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.07);" bgcolor="#ffffff">
        <!-- Header -->
        <tr><td>
            <!--[if mso]>
            <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="width:600px;">
            <v:fill type="gradient" color="#9333ea" color2="#3b82f6" angle="135"/>
            <v:textbox style="mso-fit-shape-to-text:true" inset="0,0,0,0">
            <![endif]-->
            <div style="background: linear-gradient(135deg, #9333ea 0%, #4f46e5 50%, #3b82f6 100%); background-color: #9333ea; padding: 40px; text-align: center; color: white;">
                <h1 style="margin: 0; font-size: 28px; font-weight: 700; color: white;">Your <%= contentType %> Has Been Hidden</h1>
                <p style="margin: 10px 0 0; opacity: 0.9; font-size: 16px; color: white;">Our safety system flagged your content</p>
            </div>
            <!--[if mso]></v:textbox></v:rect><![endif]-->
        </td></tr>

        <!-- Body -->
        <tr><td style="padding: 40px;">
            <p style="color: #4b5563;">Hello <strong style="color: #9333ea;"><%= username %></strong>,</p>
            <p style="font-size: 16px; color: #4b5563;">Our automated content safety system has reviewed your <%= contentType %> and determined that it may not align with our community guidelines. Your content has been hidden from the community.</p>

            <!-- Reason Box -->
            <table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 25px 0;">
            <tr><td style="background-color: #fef3c7; border: 1px solid #fcd34d; padding: 20px; border-radius: 8px; border-left: 4px solid #f59e0b;" bgcolor="#fef3c7">
                <p style="margin: 0 0 8px; color: #92400e; font-weight: 600;">Why was this hidden?</p>
                <p style="margin: 0; color: #78350f;"><%= reason %></p>
            </td></tr>
            </table>

            <% if (contentPreview) { %>
            <!-- Content Preview -->
            <table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 20px 0;">
            <tr><td style="background-color: #f9fafb; padding: 15px; border-radius: 8px; border: 1px solid #e5e7eb;" bgcolor="#f9fafb">
                <p style="margin: 0 0 5px; color: #9ca3af; font-size: 12px; text-transform: uppercase;">Your <%= contentType %></p>
                <p style="margin: 0; color: #6b7280; font-style: italic;">"<%= contentPreview %>"</p>
            </td></tr>
            </table>
            <% } %>

            <!-- What happens next -->
            <table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 25px 0;">
            <tr><td style="background-color: #faf5ff; border: 1px solid #e9d5ff; padding: 20px; border-radius: 8px;" bgcolor="#faf5ff">
                <p style="margin: 0 0 10px; color: #9333ea; font-weight: 600;">What happens next?</p>
                <ul style="margin: 0; padding-left: 20px; color: #4b5563;">
                    <li>A human moderator will review this decision</li>
                    <li>If the moderator disagrees with the AI, your content will be restored and you'll be notified</li>
                    <li>No action is needed from you at this time</li>
                </ul>
            </td></tr>
            </table>

            <p style="font-size: 14px; color: #9ca3af;">AffinityEcho uses AI-assisted moderation to keep our community safe. Our system isn't perfect — a human will always have the final say.</p>
        </td></tr>

        <!-- Footer -->
        <tr><td style="background-color: #f9fafb; padding: 20px; text-align: center; border-top: 1px solid #e5e7eb;" bgcolor="#f9fafb">
            <p style="margin: 0 0 8px; color: #9ca3af; font-size: 14px;">This is an automated moderation notification.</p>
            <p style="margin: 0; font-size: 12px; color: #9ca3af;">Need help? Contact us at <a href="mailto:<%= supportEmail %>" style="color: #4f46e5;"><%= supportEmail %></a></p>
            <p style="margin: 12px 0 0; font-size: 12px; color: #9ca3af;">&copy; 2025 AffinityEcho. Building stronger professionals together.</p>
        </td></tr>
    </table>
    </td></tr>
    </table>
</body>
</html>
